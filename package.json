{
  "name": "showtime",
  "version": "0.1.0",
  "description": "Product demos, directed by AI: Claude writes a JSON script, showTime records your web app and renders a polished MP4",
  "keywords": [
    "demo",
    "product-demo",
    "screencast",
    "screen-recording",
    "video",
    "playwright",
    "remotion",
    "claude-code",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "author": "Oleh Rylskyj",
  "homepage": "https://github.com/mineo71/showTime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineo71/showTime.git"
  },
  "bugs": {
    "url": "https://github.com/mineo71/showTime/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "showtime": "bin/showtime.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "showtime": "node bin/showtime.mjs",
    "test": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx test/helpers/serve.ts",
    "example": "node scripts/serve.mjs examples 4800",
    "media": "tsx scripts/media.ts",
    "schema:write": "node bin/showtime.mjs schema > docs/script.schema.json",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "commander": "^14.0.3",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
